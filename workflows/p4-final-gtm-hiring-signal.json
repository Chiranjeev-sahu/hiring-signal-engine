  "name": "P4 GTM Hiring Signal Engine — Final (WzvSZX5hAYXtZygU)",
  "nodes": [
    {"name": "Tally-compatible Intake", "type": "n8n-nodes-base.webhook", "typeVersion": 2.1, "parameters": {"path": "gtm-hiring-signal-v3", "httpMethod": "POST", "responseMode": "responseNode"}, "notes": "Tally webhook {company_name, domain, careers_url?} — immediate response; also Manual Trigger for demo"},
    {"name": "Manual Trigger", "type": "n8n-nodes-base.manualTrigger", "typeVersion": 1},
    {"name": "Normalize Intake", "type": "n8n-nodes-base.code", "typeVersion": 2, "notes": "Standardize input, default careers_url to https://{domain}/careers if absent; caps raw at 24k"},
    {"name": "Career URL supplied?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "parameters": {"conditions": {"conditions": [{"leftValue": "={{ $json.careers_url }}", "operator": {"type": "string", "operation": "isNotEmpty"}}]}}},
    {"name": "Use supplied careers URL", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "notes": "Map to career_url_for_extract"},
    {"name": "Tavily Search Careers", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.5, "parameters": {"method": "POST", "url": "https://api.tavily.com/search", "authentication": "predefinedCredentialType", "sendBody": true, "jsonBody": {"query": "={{ $json.company_name + \" official careers page\" }}", "search_depth": "advanced", "max_results": 5}}, "credentials": "tavily bearer"},
    {"name": "Choose Career URL", "type": "n8n-nodes-base.code", "typeVersion": 2, "notes": "Score candidates by domain match + career keywords (careers/jobs/work-with-us); pick best"},
    {"name": "Tavily Extract Career Page", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.5, "parameters": {"method": "POST", "url": "https://api.tavily.com/extract", "authentication": "predefinedCredentialType", "sendBody": true, "jsonBody": {"urls": "={{ [$json.career_url_for_extract] }}", "extract_depth": "advanced", "include_images": false}}, "credentials": "tavily bearer"},
    {"name": "Tavily Search Current Jobs", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.5, "parameters": {"method": "POST", "url": "https://api.tavily.com/search", "authentication": "predefinedCredentialType", "sendBody": true, "jsonBody": {"query": "={{ $json.company_name + \" RevOps SalesOps MarketingOps GTM CRM hiring\" }}", "search_depth": "advanced", "max_results": 5, "include_raw_content": true}}, "credentials": "tavily bearer"},
    {"name": "Prepare Career Content", "type": "n8n-nodes-base.code", "typeVersion": 2, "notes": "Merge extract markdown + jobs raw_content, strip links, dedup, cap 24k chars — feeds LLM"},
    {"name": "Extract Hiring Signal", "type": "@n8n/n8n-nodes-langchain.informationExtractor", "typeVersion": 1.2, "parameters": {"text": "={{ $json.prepared_content }}", "schemaType": "fromJson", "jsonSchemaExample": "{\"hiring_signal_type\": \"RevOps\", \"score\": 0.85, \"confidence\": 0.9, \"evidence\": \"...\", \"has_intent\": true}"}, "subnodes": {"model": "OpenRouter Hiring Classifier"}},
    {"name": "OpenRouter Hiring Classifier", "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter", "typeVersion": 1, "parameters": {"model": "minimax/minimax-m3:free", "options": {"temperature": 0, "responseFormat": "json_object"}}, "credentials": "OpenRouter account", "notes": "8 signal types: RevOps, SalesOps, MarketingOps, GTM, CRM, Sales Enablement, Demand Gen, Business Systems; threshold score≥0.55 confidence≥0.55"},
    {"name": "Normalize Hiring Signal", "type": "n8n-nodes-base.code", "typeVersion": 2, "notes": "Validate score/confidence/evidence, require positive type; enrich with signal_source_url + signal_discovered_at"},
    {"name": "Hiring Intent?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "parameters": {"conditions": {"conditions": [{"leftValue": "={{ $json.has_intent }}", "operator": {"type": "boolean", "operation": "true"}}]}}},
    {"name": "Hunter Domain Search", "type": "n8n-nodes-base.hunter", "typeVersion": 1, "parameters": {"domain": "={{ $json.domain }}", "limit": 10, "filters": {"type": "personal"}}, "credentials": "Hunter account", "notes": "Primary person source — limit 10 personal emails"},
    {"name": "Select Best Person", "type": "n8n-nodes-base.code", "typeVersion": 2, "notes": "Function scoring RevOps/GTM/SalesOps/MarketingOps/CRM against title; threshold ≥100; emits person_found"},
    {"name": "Person Found?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "parameters": {"conditions": {"conditions": [{"leftValue": "={{ $json.person_found }}", "operator": {"type": "boolean", "operation": "true"}}]}}},
    {"name": "Tavily Find Person", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.5, "parameters": {"method": "POST", "url": "https://api.tavily.com/search", "authentication": "predefinedCredentialType", "sendBody": true, "jsonBody": {"query": "={{ \"site:linkedin.com/in \" + $json.company_name + \" RevOps SalesOps MarketingOps GTM CRM\" }}", "max_results": 5}}, "credentials": "tavily bearer", "notes": "Fallback when Hunter miss — LinkedIn search"},
    {"name": "Parse Tavily Person", "type": "n8n-nodes-base.code", "typeVersion": 2, "notes": "Filter current employees in target functions; function score ≥0.75"},
    {"name": "Prospeo Find Verified Email", "type": "@prospeo/n8n-nodes-prospeo.prospeo", "typeVersion": 1, "parameters": {"operation": "findEmail"}, "credentials": "Prospeo account", "notes": "Requires LinkedIn URL + name + company from prior person node"},
    {"name": "Prospeo Email Found?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "parameters": {"conditions": {"conditions": [{"leftValue": "={{ $json.email }}", "operator": {"type": "string", "operation": "isNotEmpty"}}]}}},
    {"name": "Dropcontact Fallback", "type": "n8n-nodes-base.dropcontact", "typeVersion": 1, "parameters": {"resource": "contact", "operation": "enrich", "options": {"language": "en"}}, "credentials": "Dropcontact account", "notes": "Fallback — wait 45s before verify"},
    {"name": "ZeroBounce Verify", "type": "@zerobounce/n8n-nodes-zerobounce.zeroBounce", "typeVersion": 1, "parameters": {"apiEndpoint": "https://api-us.zerobounce.net/v2"}, "credentials": "ZeroBounce account", "notes": "Gate: only status=valid proceeds; uses api-us to avoid Railway 1020"},
    {"name": "Finalize Verified Contact", "type": "n8n-nodes-base.code", "typeVersion": 2, "notes": "Merge signal + person + email into final payload for HubSpot/Slack"},
    {"name": "Valid Email?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "parameters": {"conditions": {"conditions": [{"leftValue": "={{ $json.status }}", "operator": {"type": "string", "operation": "equals"}, "rightValue": "valid"}]}}},
    {"name": "HubSpot Upsert Contact", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.5, "parameters": {"method": "POST", "url": "https://api.hubapi.com/crm/v3/objects/contacts"}, "credentials": "HubSpot Service Key account", "notes": "Upsert with 11 custom properties (hiring_signal_* + person_* + email_* + signal_source_url/discovered_at); portal 247212224"},
    {"name": "Slack Hiring Signal", "type": "n8n-nodes-base.slack", "typeVersion": 2.7, "parameters": {"resource": "message", "operation": "post", "channelId": "C0BN1L6KDBR", "messageType": "block"}, "credentials": "GTM Hiring Signals Slack", "notes": "Block Kit to #all-fafo with company, signal type/score/evidence, person name/title/linkedin, email + sources"},
    {"name": "Quarantine / No Match", "type": "n8n-nodes-base.code", "typeVersion": 2, "notes": "Tags quarantined:true + reason: no_hiring_intent | no_person_found | email_not_verified — never reaches HubSpot/Slack main path"}
  ],
